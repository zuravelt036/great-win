<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.App.Mono" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/color_gold</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/btn_primary_height</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="cornerRadius">@dimen/btn_radius</item>
        <item name="strokeColor">@color/color_gold</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="rippleColor">@color/ripple_gold</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:elevation">@dimen/elevation_cta</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="iconTint">@color/color_gold</item>
        <item name="iconSize">@dimen/icon_in_btn</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_md</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/btn_secondary_height</item>
        <item name="backgroundTint">@color/color_surface_translucent</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/color_secondary</item>
        <item name="strokeWidth">@dimen/stroke_card</item>
        <item name="rippleColor">@color/ripple_teal</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textColor">@color/color_secondary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/color_secondary</item>
        <item name="iconSize">@dimen/icon_in_btn</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/icon_btn</item>
        <item name="android:minHeight">@dimen/icon_btn</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/color_surface_translucent</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/color_stroke_teal</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="rippleColor">@color/ripple_teal</item>
        <item name="iconTint">@color/color_secondary</item>
        <item name="iconSize">@dimen/icon_in_btn</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="Widget.App.Card.Surface" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">@color/color_surface_translucent</item>
        <item name="strokeColor">@color/color_stroke</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <style name="Widget.App.Card.Hud" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/panel_radius</item>
        <item name="cardBackgroundColor">@color/color_surface_strong</item>
        <item name="strokeColor">@color/color_stroke_teal</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <style name="Widget.App.Progress.Loader" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/progress_height</item>
        <item name="trackCornerRadius">2dp</item>
        <item name="indicatorColor">@color/color_secondary</item>
        <item name="trackColor">@color/color_surface_alt</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.Title</item>
        <item name="titleTextColor">@color/color_text_primary</item>
        <item name="navigationIconTint">@color/color_secondary</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:textAppearance">@style/TextAppearance.App.Label</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:minHeight">@dimen/btn_min_touch</item>
    </style>

</resources>
